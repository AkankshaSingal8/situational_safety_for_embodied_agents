+
+# ═══════════════════════════════════════════════════════════════════════════════
+# Constants
+# ═══════════════════════════════════════════════════════════════════════════════
+LIBERO_DUMMY_ACTION = [0.0] * 6 + [-1.0]
+LIBERO_ENV_RESOLUTION = 256
+
+# Max episode steps per suite (from VLSA/SafeLIBERO paper, Table 1 / Appendix)
+MAX_STEPS = {
+    "safelibero_spatial": 300,
+    "safelibero_object": 300,
+    "safelibero_goal": 300,
+    "safelibero_long": 550,
+}
+
+# OpenVLA-OFT: suite -> HuggingFace checkpoint
+OPENVLA_OFT_CHECKPOINTS = {
+    "safelibero_spatial": "moojink/openvla-7b-oft-finetuned-libero-spatial",
+    "safelibero_object": "moojink/openvla-7b-oft-finetuned-libero-object",
+    "safelibero_goal": "moojink/openvla-7b-oft-finetuned-libero-goal",
+    "safelibero_long": "moojink/openvla-7b-oft-finetuned-libero-10",
+}
+
+# OpenVLA-OFT: suite -> unnormalization key (matches LIBERO training dataset names)
+OPENVLA_OFT_UNNORM_KEYS = {
+    "safelibero_spatial": "libero_spatial",
+    "safelibero_object": "libero_object",
+    "safelibero_goal": "libero_goal",
+    "safelibero_long": "libero_10",
+}
+
+# OpenVLA-OFT: checkpoint -> action head filename on HuggingFace
+OPENVLA_OFT_ACTION_HEAD_FILES = {
+    "moojink/openvla-7b-oft-finetuned-libero-spatial": "action_head--150000_checkpoint.pt",
+    "moojink/openvla-7b-oft-finetuned-libero-object": "action_head--150000_checkpoint.pt",
+    "moojink/openvla-7b-oft-finetuned-libero-goal": "action_head--50000_checkpoint.pt",
+    "moojink/openvla-7b-oft-finetuned-libero-10": "action_head--150000_checkpoint.pt",
+}
+
+# OpenVLA-OFT: checkpoint -> proprio projector filename on HuggingFace
+OPENVLA_OFT_PROPRIO_FILES = {
+    "moojink/openvla-7b-oft-finetuned-libero-spatial": "proprio_projector--150000_checkpoint.pt",
+    "moojink/openvla-7b-oft-finetuned-libero-object": "proprio_projector--150000_checkpoint.pt",
+    "moojink/openvla-7b-oft-finetuned-libero-goal": "proprio_projector--50000_checkpoint.pt",
+    "moojink/openvla-7b-oft-finetuned-libero-10": "proprio_projector--150000_checkpoint.pt",
+}
+
+# OpenVLA-OFT model constants (from prismatic.vla.constants for LIBERO)
+OPENVLA_IMAGE_SIZE = 224
+OPENVLA_NUM_ACTIONS_CHUNK = 8
+OPENVLA_ACTION_DIM = 7
+OPENVLA_PROPRIO_DIM = 8
+OPENVLA_NUM_OPEN_LOOP_STEPS = 8
+OPENVLA_CENTER_CROP_SCALE = 0.9
+
+# Pi0.5 constants
+PI05_N_ACTION_STEPS = 10
