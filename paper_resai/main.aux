\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Five-architecture board on LIBERO-Safety physical suites (TSR\tmspace  +\thinmuskip {.1667em}/\tmspace  +\thinmuskip {.1667em}violation\%; $n{=}450$ per cell on obstacle and human suites for baseline and the corresponding ours arms, $n{=}150$ elsewhere, obst.-human $n{=}750$; macro = suite mean of TSR\tmspace  +\thinmuskip {.1667em}/\tmspace  +\thinmuskip {.1667em}viol.\tmspace  +\thinmuskip {.1667em}/\tmspace  +\thinmuskip {.1667em}safe-SR). All arms share one policy, protocol, and violation criterion; comparisons are against our self-run baseline at execution parity. \textbf  {Bold}: best TSR per suite. $^*$paired exact McNemar vs.\ baseline, $50{:}31$ discordant, $p{=}0.045$.}}{4}{table.3}}
\newlabel{tab:board}{{III}{4}{Five-architecture board on LIBERO-Safety physical suites (TSR\,/\,violation\%; $n{=}450$ per cell on obstacle and human suites for baseline and the corresponding ours arms, $n{=}150$ elsewhere, obst.-human $n{=}750$; macro = suite mean of TSR\,/\,viol.\,/\,safe-SR). All arms share one policy, protocol, and violation criterion; comparisons are against our self-run baseline at execution parity. \textbf {Bold}: best TSR per suite. $^*$paired exact McNemar vs.\ baseline, $50{:}31$ discordant, $p{=}0.045$}{table.3}{}}
