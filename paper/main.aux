\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The SafeLIBERO five-arm board (Table\nobreakspace  {}\ref  {tab:board}) as task success (top) over collision avoidance (bottom), eight cells. The no-GT column beats both the baseline and the SOTA reimplementation on both axes in 4/8 cells; every shield architecture collapses Long-horizon success.}}{7}{figure.4}}
\newlabel{fig:slboard}{{4}{7}{The SafeLIBERO five-arm board (Table~\ref {tab:board}) as task success (top) over collision avoidance (bottom), eight cells. The no-GT column beats both the baseline and the SOTA reimplementation on both axes in 4/8 cells; every shield architecture collapses Long-horizon success}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Five-row architecture board: TSR/CAR (\%), $n{=}200$ per cell, one collision criterion ($>$1\tmspace  +\thinmuskip {.1667em}mm GT-hazard displacement), enforcement = composed in-denoising configuration (per-cell best config). \textbf  {Bold}: beats \emph  {both} the baseline and the SOTA reimplementation on that axis. $^\dagger $nominal (Fisher n.s., $p=0.64/0.69$). $^\ddagger $table-prior ablation 44.0/79.5; the VLM guards spillable food where the benchmark designates a book/mug (benchmark-definition divergence, Sec.\nobreakspace  {}\ref  {sec:limitations}).}}{7}{table.3}}
\newlabel{tab:board}{{III}{7}{Five-row architecture board: TSR/CAR (\%), $n{=}200$ per cell, one collision criterion ($>$1\,mm GT-hazard displacement), enforcement = composed in-denoising configuration (per-cell best config). \textbf {Bold}: beats \emph {both} the baseline and the SOTA reimplementation on that axis. $^\dagger $nominal (Fisher n.s., $p=0.64/0.69$). $^\ddagger $table-prior ablation 44.0/79.5; the VLM guards spillable food where the benchmark designates a book/mug (benchmark-definition divergence, Sec.~\ref {sec:limitations})}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The LIBERO-Safety five-arm board (Table\nobreakspace  {}\ref  {tab:lsboard}) as task success (top) over benchmark violation rate (bottom). Both dedicated shields collapse the human-safety suite (37.3/32.7 vs.\ baseline 85.8) while our no-GT stack holds it at baseline --- safety by freezing versus safety while moving --- and cuts violations to 0.6\% macro vs.\ the baseline's 2.5\%.}}{8}{figure.5}}
\newlabel{fig:lsboard}{{5}{8}{The LIBERO-Safety five-arm board (Table~\ref {tab:lsboard}) as task success (top) over benchmark violation rate (bottom). Both dedicated shields collapse the human-safety suite (37.3/32.7 vs.\ baseline 85.8) while our no-GT stack holds it at baseline --- safety by freezing versus safety while moving --- and cuts violations to 0.6\% macro vs.\ the baseline's 2.5\%}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces LIBERO-Safety five-arm board, safety-finetuned $\pi _{0.5}$ checkpoint, per-suite TSR\tmspace  +\thinmuskip {.1667em}/\tmspace  +\thinmuskip {.1667em}violation\% (benchmark contact predicates; suites: obstacle avoidance, human safety, obstacle$+$hands, affordance). Cells are $n{=}150$; baseline and ours cells feeding significance claims pool $n{=}450$--$750$ (batch-aware pairing); macros follow the pooled recomputation.}}{8}{table.4}}
\newlabel{tab:lsboard}{{IV}{8}{LIBERO-Safety five-arm board, safety-finetuned $\pi _{0.5}$ checkpoint, per-suite TSR\,/\,violation\% (benchmark contact predicates; suites: obstacle avoidance, human safety, obstacle$+$hands, affordance). Cells are $n{=}150$; baseline and ours cells feeding significance claims pool $n{=}450$--$750$ (batch-aware pairing); macros follow the pooled recomputation}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The certificate at work over one episode (the pair of Fig.\nobreakspace  {}\ref  {fig:teaser}). Clearance $h(t)$ to the hand-attached hazard: the unfiltered base policy (gray) crosses $h{=}0$ at $t{=}136$ and spends 215 of 600 steps in violation; ours (blue) dips to $+0.021$\tmspace  +\thinmuskip {.1667em}m at its closest approach and never crosses, completing the task at $t{=}510$.}}{8}{figure.6}}
\newlabel{fig:filmstrip}{{6}{8}{The certificate at work over one episode (the pair of Fig.~\ref {fig:teaser}). Clearance $h(t)$ to the hand-attached hazard: the unfiltered base policy (gray) crosses $h{=}0$ at $t{=}136$ and spends 215 of 600 steps in violation; ours (blue) dips to $+0.021$\,m at its closest approach and never crosses, completing the task at $t{=}510$}{figure.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {IX}Experiments V: Which Literal Does the Work? Paired FOL Ablations}{8}{section.9}}
\newlabel{sec:ablation}{{IX}{8}{Experiments V: Which Literal Does the Work? Paired FOL Ablations}{section.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces What each conjunct of Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:fol}\unskip \@@italiccorr )}} buys, on one human-safety scene, computed by the deployed election code. (a)\nobreakspace  {}Full rule: the hand is guarded, the task's bowls are exempt. (b)\nobreakspace  {}Delete all logic (geometric top-$k$): the task's own bowl is guarded and the hand is missed. (c)\nobreakspace  {}Delete the language exemptions: a task-mentioned bowl is guarded --- self-paralysis. (d)\nobreakspace  {}Delete the class predicates: the human hand is left unguarded.}}{9}{figure.7}}
\newlabel{fig:ablation}{{7}{9}{What each conjunct of Eq.~\eqref {eq:fol} buys, on one human-safety scene, computed by the deployed election code. (a)~Full rule: the hand is guarded, the task's bowls are exempt. (b)~Delete all logic (geometric top-$k$): the task's own bowl is guarded and the hand is missed. (c)~Delete the language exemptions: a task-mentioned bowl is guarded --- self-paralysis. (d)~Delete the class predicates: the human hand is left unguarded}{figure.7}{}}
