<mujoco model="rice_pour_pilot">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="5"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4"/>
  </visual>
  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.4 0.4 0.4" rgb2="0.5 0.5 0.5" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="1 1 0.1" material="groundplane"/>

    <!-- Source container ("bowl" being poured from). Free body so we can script a tilt. -->
    <body name="source_bowl" pos="-0.15 0 0.05">
      <freejoint name="source_bowl_joint"/>
      <geom name="source_bottom" type="cylinder" size="0.06 0.005" pos="0 0 0" rgba="0.6 0.4 0.2 1"/>
      <geom name="source_wall1" type="box" size="0.005 0.06 0.05" pos="0.06 0 0.05" rgba="0.6 0.4 0.2 0.6"/>
      <geom name="source_wall2" type="box" size="0.005 0.06 0.05" pos="-0.06 0 0.05" rgba="0.6 0.4 0.2 0.6"/>
      <geom name="source_wall3" type="box" size="0.06 0.005 0.05" pos="0 0.06 0.05" rgba="0.6 0.4 0.2 0.6"/>
      <!-- wall4 omitted: open pour-side facing +x toward the target bowl -->
    </body>

    <!-- Target container (bowl being poured into) -->
    <body name="target_bowl" pos="0.15 0 0.05">
      <geom name="target_bottom" type="cylinder" size="0.07 0.005" pos="0 0 0" rgba="0.2 0.4 0.6 1"/>
      <geom name="target_wall1" type="box" size="0.005 0.07 0.05" pos="0.07 0 0.05" rgba="0.2 0.4 0.6 0.6"/>
      <geom name="target_wall2" type="box" size="0.005 0.07 0.05" pos="-0.07 0 0.05" rgba="0.2 0.4 0.6 0.6"/>
      <geom name="target_wall3" type="box" size="0.07 0.005 0.05" pos="0 0.07 0.05" rgba="0.2 0.4 0.6 0.6"/>
      <geom name="target_wall4" type="box" size="0.07 0.005 0.05" pos="0 -0.07 0.05" rgba="0.2 0.4 0.6 0.6"/>
    </body>

    <!-- Rice grains: MuJoCo composite particle cluster, auto-expanded into 30 top-level
         free bodies by the compiler (avoids the "freejoint must be top-level" constraint
         hit when nesting free grain bodies inside a parent object body). -->
    <composite type="particle" count="3 2 5" spacing="0.018" offset="-0.15 0 0.12">
      <geom size="0.006" rgba="0.92 0.85 0.6 1" friction="0.6 0.005 0.0001" condim="4"
            solimp="0.9 0.95 0.001" solref="0.005 1" density="600"/>
    </composite>
  </worldbody>
</mujoco>
