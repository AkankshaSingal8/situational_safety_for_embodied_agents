<mujoco model="skittles_scatter_pilot">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="5"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4"/>
  </visual>
  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.4 0.4 0.4" rgb2="0.5 0.5 0.5" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="1 1 0.1" material="groundplane"/>

    <!-- Bag proxy: an open-top pouch (no lid geom on +x face), simplified as a shallow box
         container rather than a deformable mesh — same simplification level as the rice
         pilot's source_bowl, consistent for a physics-fidelity pilot. -->
    <body name="bag" pos="-0.15 0 0.05">
      <freejoint name="bag_joint"/>
      <geom name="bag_bottom" type="box" size="0.05 0.035 0.005" pos="0 0 0" rgba="0.9 0.15 0.15 1"/>
      <geom name="bag_wall1" type="box" size="0.005 0.035 0.04" pos="0.05 0 0.04" rgba="0.9 0.15 0.15 0.6"/>
      <geom name="bag_wall2" type="box" size="0.005 0.035 0.04" pos="-0.05 0 0.04" rgba="0.9 0.15 0.15 0.6"/>
      <geom name="bag_wall3" type="box" size="0.05 0.005 0.04" pos="0 0.035 0.04" rgba="0.9 0.15 0.15 0.6"/>
      <!-- wall4 omitted: open top-pour edge, matches rice pilot's open-side convention -->
    </body>

    <!-- Target bowl: same footprint/position as the rice pilot's target_bowl so results
         are comparable, but slightly smaller rim height (0.035 vs 0.05) since candies are
         bigger/flatter than rice grains and a taller rim would trivially contain everything,
         defeating the point of testing scatter dynamics. -->
    <body name="target_bowl" pos="0.15 0 0.05">
      <geom name="target_bottom" type="cylinder" size="0.07 0.005" pos="0 0 0" rgba="0.2 0.4 0.6 1"/>
      <geom name="target_wall1" type="box" size="0.005 0.07 0.035" pos="0.07 0 0.035" rgba="0.2 0.4 0.6 0.6"/>
      <geom name="target_wall2" type="box" size="0.005 0.07 0.035" pos="-0.07 0 0.035" rgba="0.2 0.4 0.6 0.6"/>
      <geom name="target_wall3" type="box" size="0.07 0.005 0.035" pos="0 0.07 0.035" rgba="0.2 0.4 0.6 0.6"/>
      <geom name="target_wall4" type="box" size="0.07 0.005 0.035" pos="0 -0.07 0.035" rgba="0.2 0.4 0.6 0.6"/>
    </body>

    <!-- Skittles: 20 flattened-capsule candies (larger, lower-friction than rice grains, to
         produce more bounce/roll on impact). Composite particle cluster again auto-expands
         to top-level free bodies — same workaround as the rice pilot, since nesting free
         bodies inside a parent object body hits MuJoCo's "freejoint must be top-level"
         constraint either way. -->
    <composite type="particle" count="4 5 1" spacing="0.022" offset="-0.15 0 0.10">
      <geom size="0.009 0.004" type="capsule" rgba="0.95 0.6 0.1 1" friction="0.25 0.003 0.0001"
            condim="4" solimp="0.9 0.95 0.001" solref="0.005 1" density="900"/>
    </composite>
  </worldbody>
</mujoco>
